PORT=3000
PUBLIC_URL=http://localhost:3000
# Set equal to PUBLIC_URL for one Render service; use http://localhost:3000 locally.
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-application-client-secret
DISCORD_BOT_TOKEN=your-discord-bot-token
# Main channel. Status and live channels are optional.
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=your-announcements-channel-id
DISCORD_STATUS_CHANNEL_ID=your-status-channel-id
DISCORD_LIVE_CHANNEL_ID=your-live-channel-id
# Secret used by POST /api/integrations/discord/events.
DISCORD_EVENTS_WEBHOOK_SECRET=replace-with-a-long-random-secret
DEV_PASSWORD=replace-with-a-strong-dev-password
DISCORD_DEV_USER_ID=your-authorized-discord-user-id
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
